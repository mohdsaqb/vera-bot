# Copy to .env and edit, or set these in your hosting platform's dashboard.
# Never commit .env — it is gitignored. Only GROQ_API_KEY is a secret.
#
# SET THESE BEFORE SUBMITTING — they are what the judge reports back:
#   TEAM_NAME, TEAM_MEMBERS, CONTACT_EMAIL, SUBMITTED_AT
# The defaults are placeholders and will appear verbatim in /v1/metadata.
#
# Everything here has a working default. The bot starts and serves with no
# environment at all; it simply writes every message deterministically.

APP_ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Bot identity
BOT_NAME=Vera
BOT_VERSION=1.0.0

# GET /v1/metadata fields. TEAM_MEMBERS is comma-separated.
TEAM_NAME=Your Team Name
TEAM_MEMBERS=Your Name,Second Name
MODEL_NAME=llama-3.3-70b-versatile via Groq, wording only
APPROACH=deterministic 4-context decision engine; LLM wording with grounding validation
CONTACT_EMAIL=you@example.com
# Optional; defaults to process start time when unset.
SUBMITTED_AT=

# --- LLM wording layer ------------------------------------------------------
# Leave LLM_PROVIDER empty to run fully deterministically: the decision engine
# needs no model, and every message still gets written, validated and sent.
#
# Set it to "groq" to have the model word the bodies. It can only change wording:
# the trigger, signal, offer, action, CTA, sender, suppression key and rationale
# are decided in Python and are not sent to the model for approval. Any
# ungrounded, multi-ask or off-voice generation is discarded for the
# deterministic rendering.
LLM_PROVIDER=
# Must be a model your Groq account currently serves — check
# https://console.groq.com/docs/models, since ids are retired over time.
LLM_MODEL=llama-3.3-70b-versatile
# 0 for the most reproducible output the provider supports.
LLM_TEMPERATURE=0
# Per-call ceiling. /v1/tick has a 10s budget, /v1/reply 10s.
LLM_TIMEOUT_SECONDS=6
LLM_MAX_TOKENS=320
# "function_calling" works on Llama models; "json_schema" only on some others.
LLM_STRUCTURED_METHOD=function_calling
# Per-tick ceilings: beyond these, remaining messages render deterministically.
LLM_MAX_CALLS_PER_TICK=6
LLM_TICK_BUDGET_SECONDS=8

# Secret. Never commit a real key — .env is gitignored.
GROQ_API_KEY=
